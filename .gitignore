# ============================================================
#  TEMPLOAD — .gitignore
#  Covers: Frontend (React/Vite), Backend/API (Cloudflare Workers),
#          Node.js, OS files, editor dirs, and environment secrets
# ============================================================

# ─── Environment / Secrets ────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.dev.vars          # Wrangler (Cloudflare Workers) local secrets
*.secret
*.secrets

# ─── Node / npm / yarn / pnpm ─────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ─── Build Output ─────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.output/
.vercel/
.netlify/

# ─── Vite Specific ────────────────────────────────────────────
vite.config.js.timestamp-*

# ─── Cloudflare Workers / Wrangler (Backend API) ──────────────
.wrangler/
wrangler.toml.local
worker-dist/
.cache/
*.d1.sqlite
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ─── Logs ─────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── OS Generated ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Editor / IDE ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.project
.classpath
*.tmproject
*.sublime-project
*.sublime-workspace

# ─── Testing ──────────────────────────────────────────────────
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/

# ─── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ─── Temporary / Misc ─────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
*.patch
New Text Document.txt
